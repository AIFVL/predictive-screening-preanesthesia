# Copy this file to .env and fill in your values before running docker compose.
#
# Generate a Fernet key (run once):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

AIRFLOW__CORE__FERNET_KEY=replace_with_generated_fernet_key

# Optional: override the default Airflow admin credentials
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
